{
  "openapi": "3.1.0",
  "info": {
    "title": "Metabolomics Pathway Flux Engine API",
    "description": "Deterministic prototype threshold evaluation. No clinical validation or FBA.",
    "version": "2.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "JSON object with process-local counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate heuristic measurement and descriptor rules",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return deterministic mock response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read administrative HMAC audit records with bearer token",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "401": {
            "description": "Unauthorized"
          },
          "503": {
            "description": "Not enabled"
          }
        },
        "security": [
          {
            "AuditLogToken": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AuditLogToken": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
